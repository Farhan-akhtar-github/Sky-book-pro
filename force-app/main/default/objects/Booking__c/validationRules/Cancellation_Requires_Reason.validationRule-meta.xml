<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cancellation_Requires_Reason</fullName>
    <active>true</active>
    <errorConditionFormula>ISCHANGED(Booking_Status__c) &amp;&amp; ISPICKVAL(Booking_Status__c,
&quot;Cancelled&quot;) &amp;&amp; ISBLANK(Cancellation_Reason__c)</errorConditionFormula>
    <errorMessage>Please provide a Cancellation Reason before changing the Booking Status to Cancelled</errorMessage>
</ValidationRule>
