<apex:page controller="DashboardController" lightningStylesheets="true" title="SkyBook Pro – Operations Dashboard" docType="html-5.0">
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
        <style>
            :root {
                --primary:       hsl(210, 80%, 40%);
                --primary-dark:  hsl(210, 80%, 30%);
                --primary-light: hsl(210, 80%, 95%);
                --success:       hsl(140, 60%, 40%);
                --danger:        hsl(0, 75%, 45%);
                --warning:       hsl(45, 90%, 40%);
                --bg:            #f3f4f6;
                --card:          #ffffff;
                --text:          #1f2937;
                --text-muted:    #6b7280;
                --border:        #e5e7eb;
                --radius:        10px;
                --shadow:        0 2px 12px rgba(0,0,0,0.08);
            }

            body, .bPageBlock, .bPageBlockSection, .pbBody, .pbHeader {
                font-family: 'Inter', sans-serif !important;
            }

            /* ── Layout ─────────────────────────────────────────── */
            .skp-page       { background: var(--bg); min-height: 100vh; padding: 24px; box-sizing: border-box; }
            .skp-header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; flex-wrap: wrap; gap: 14px; }
            .skp-header     { display: flex; align-items: center; gap: 14px; }
            .skp-logo       { width: 42px; height: 42px; background: linear-gradient(135deg, var(--primary), hsl(210, 80%, 55%)); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 18px; }
            .skp-title      { font-size: 24px; font-weight: 700; color: var(--text); }
            .skp-subtitle   { font-size: 13px; color: var(--text-muted); margin-top: 2px; }
            .skp-user-info  { font-size: 13px; color: var(--text-muted); text-align: right; }

            /* ── Cards ──────────────────────────────────────────── */
            .skp-card       { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); padding: 24px; margin-bottom: 20px; }
            .skp-card-title { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 18px; display: flex; align-items: center; gap: 8px; border-bottom: 1.5px solid var(--border); padding-bottom: 10px; }

            /* ── KPI Grid ───────────────────────────────────────── */
            .skp-kpi-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 20px;
                margin-bottom: 24px;
            }
            .skp-kpi-card {
                background: var(--card);
                border-radius: var(--radius);
                box-shadow: var(--shadow);
                padding: 20px;
                display: flex;
                flex-direction: column;
                gap: 8px;
                transition: transform 0.2s, box-shadow 0.2s;
            }
            .skp-kpi-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 18px rgba(0,0,0,0.12);
            }
            .skp-kpi-label {
                font-size: 11px;
                font-weight: 600;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 0.05em;
            }
            .skp-kpi-num {
                font-size: 28px;
                font-weight: 700;
                color: var(--primary);
            }
            .skp-kpi-num-success { color: var(--success); }
            .skp-kpi-num-danger  { color: var(--danger); }

            /* ── Grid Rows ──────────────────────────────────────── */
            .skp-dashboard-row {
                display: grid;
                grid-template-columns: 2fr 1fr;
                gap: 24px;
                margin-bottom: 20px;
            }
            @media (max-width: 768px) {
                .skp-dashboard-row {
                    grid-template-columns: 1fr;
                }
            }

            /* ── Progress Bar ───────────────────────────────────── */
            .skp-progress-bar-bg {
                width: 100%;
                height: 8px;
                background: var(--border);
                border-radius: 4px;
                overflow: hidden;
                margin-top: 8px;
            }
            .skp-progress-bar-fill {
                height: 100%;
                background: var(--primary);
                border-radius: 4px;
                transition: width 0.4s ease;
            }

            /* ── Status Row ─────────────────────────────────────── */
            .skp-status-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 14px 0;
                border-bottom: 1px solid var(--border);
            }
            .skp-status-row:last-child {
                border-bottom: none;
            }
            .skp-status-val {
                font-weight: 700;
                font-size: 16px;
                color: var(--text);
            }

            /* ── Buttons ─────────────────────────────────────────── */
            .skp-btn         { padding: 10px 22px; border: none; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; transition: background 0.2s, transform 0.1s; font-family: 'Inter', sans-serif; text-decoration: none; display: inline-block; }
            .skp-btn:active  { transform: scale(0.98); }
            .skp-btn-primary { background: var(--primary); color: white; }
            .skp-btn-primary:hover { background: var(--primary-dark); }
            .skp-btn-outline { background: white; color: var(--primary); border: 1.5px solid var(--primary); }
            .skp-btn-outline:hover { background: var(--primary-light); }
            .skp-actions-row { display: flex; align-items: center; gap: 12px; margin-top: 18px; flex-wrap: wrap; }

            /* ── Alerts ──────────────────────────────────────────── */
            .skp-alert         { padding: 12px 16px; border-radius: 8px; font-size: 13px; font-weight: 500; margin-bottom: 16px; }
            .skp-alert-error   { background: hsl(0, 75%, 97%); color: var(--danger); border: 1px solid hsl(0, 75%, 85%); }

            /* ── Tables ──────────────────────────────────────────── */
            .skp-table-wrap { overflow-x: auto; }
            .skp-table      { width: 100%; border-collapse: collapse; font-size: 13px; }
            .skp-table thead th { padding: 10px 14px; background: hsl(210, 20%, 97%); color: var(--text-muted); font-weight: 600; font-size: 11px; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1.5px solid var(--border); text-align: left; white-space: nowrap; }
            .skp-table tbody tr { border-bottom: 1px solid var(--border); transition: background 0.15s; }
            .skp-table tbody tr:hover { background: hsl(210, 80%, 98%); }
            .skp-table tbody td { padding: 12px 14px; color: var(--text); vertical-align: middle; }

            /* ── Status badges ───────────────────────────────────── */
            .skp-badge          { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: 11px; font-weight: 600; }
            .skp-badge-green    { background: hsl(140, 60%, 92%); color: hsl(140, 60%, 28%); }
            .skp-badge-yellow   { background: hsl(45, 90%, 92%);  color: hsl(45, 90%, 28%);  }
            .skp-badge-red      { background: hsl(0, 75%, 92%);   color: hsl(0, 75%, 30%);   }

            /* ── Misc ────────────────────────────────────────────── */
            .skp-amount  { font-weight: 700; color: var(--primary); }
            .skp-empty   { text-align: center; padding: 32px 24px; color: var(--text-muted); font-size: 14px; }
        </style>
    </head>
    <apex:form id="mainForm">
        <div class="skp-page">

            <!-- ══════════════════════════════════════════════════
                 Page Header
            ═══════════════════════════════════════════════════ -->
            <div class="skp-header-row">
                <div class="skp-header">
                    <div class="skp-logo">✈</div>
                    <div>
                        <div class="skp-title">SkyBook Pro</div>
                        <div class="skp-subtitle">Operations &amp; Business Analytics</div>
                    </div>
                </div>
                <div class="skp-user-info">
                    <strong>Logged in as:</strong> <apex:outputText value="{!$User.FirstName} {!$User.LastName}"/><br/>
                    <strong>Date:</strong> <apex:outputText value="{0,date,dd MMMM yyyy}"><apex:param value="{!TODAY()}"/></apex:outputText>
                </div>
            </div>

            <!-- ── Error Panel ─────────────────────────────────── -->
            <apex:outputPanel id="errorPanel" rendered="{!hasError}">
                <div class="skp-card">
                    <div class="skp-alert skp-alert-error">
                        ⚠ <apex:outputText value="{!errorMessage}"/>
                    </div>
                </div>
            </apex:outputPanel>

            <apex:outputPanel id="dashboardPanel" rendered="{!NOT(hasError)}">

                <!-- ══════════════════════════════════════════════════
                     Section 2 · KPI Cards Row
                ═══════════════════════════════════════════════════ -->
                <div class="skp-kpi-grid">
                    <div class="skp-kpi-card">
                        <span class="skp-kpi-label">Total Bookings</span>
                        <span class="skp-kpi-num"><apex:outputText value="{!totalBookings}"/></span>
                    </div>
                    <div class="skp-kpi-card">
                        <span class="skp-kpi-label">Confirmed Bookings</span>
                        <span class="skp-kpi-num skp-kpi-num-success"><apex:outputText value="{!confirmedBookings}"/></span>
                    </div>
                    <div class="skp-kpi-card">
                        <span class="skp-kpi-label">Cancelled Bookings</span>
                        <span class="skp-kpi-num skp-kpi-num-danger"><apex:outputText value="{!cancelledBookings}"/></span>
                    </div>
                    <div class="skp-kpi-card">
                        <span class="skp-kpi-label">Total Revenue</span>
                        <span class="skp-kpi-num skp-kpi-num-success">
                            <apex:outputText value="{0,number, $#,##0.00}">
                                <apex:param value="{!totalRevenue}"/>
                            </apex:outputText>
                        </span>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════════════
                     Section 3 · Analytics Row (Revenue & Breakdown)
                ═══════════════════════════════════════════════════ -->
                <div class="skp-dashboard-row">
                    <!-- Left Column: Revenue Table -->
                    <div class="skp-card">
                        <div class="skp-card-title">📈 Monthly Revenue Analytics</div>
                        
                        <apex:outputPanel rendered="{!monthlyRevenue.size == 0}">
                            <div class="skp-empty">No confirmed revenue logs recorded.</div>
                        </apex:outputPanel>

                        <apex:outputPanel rendered="{!monthlyRevenue.size > 0}">
                            <div class="skp-table-wrap">
                                <table class="skp-table">
                                    <thead>
                                        <tr>
                                            <th>Month</th>
                                            <th style="width: 50%;">Progress &amp; Scale</th>
                                            <th>Revenue</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <apex:repeat value="{!monthlyRevenue}" var="m">
                                            <tr>
                                                <td><strong><apex:outputText value="{!m.monthName}"/></strong></td>
                                                <td>
                                                    <div class="skp-progress-bar-bg" title="{!m.percent}% of peak month">
                                                        <div class="skp-progress-bar-fill" style="width: {!m.percent}%;"></div>
                                                    </div>
                                                </td>
                                                <td>
                                                    <span class="skp-amount">
                                                        <apex:outputText value="{0,number,$#,##0.00}">
                                                            <apex:param value="{!m.revenue}"/>
                                                        </apex:outputText>
                                                    </span>
                                                </td>
                                            </tr>
                                        </apex:repeat>
                                    </tbody>
                                </table>
                            </div>
                        </apex:outputPanel>
                    </div>

                    <!-- Right Column: Status Breakdown -->
                    <div class="skp-card">
                        <div class="skp-card-title">📊 Booking Status</div>
                        
                        <div class="skp-status-row">
                            <span class="skp-badge skp-badge-yellow">Draft</span>
                            <span class="skp-status-val"><apex:outputText value="{!draftBookings}"/></span>
                        </div>
                        <div class="skp-status-row">
                            <span class="skp-badge skp-badge-green">Confirmed</span>
                            <span class="skp-status-val"><apex:outputText value="{!confirmedBookings}"/></span>
                        </div>
                        <div class="skp-status-row">
                            <span class="skp-badge skp-badge-red">Cancelled</span>
                            <span class="skp-status-val"><apex:outputText value="{!cancelledBookings}"/></span>
                        </div>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════════════
                     Section 4 · Upcoming Departures
                ═══════════════════════════════════════════════════ -->
                <div class="skp-card">
                    <div class="skp-card-title">✈ Upcoming Departures (Next 10 Flights)</div>

                    <apex:outputPanel rendered="{!upcomingFlights.size == 0}">
                        <div class="skp-empty">No upcoming departures found.</div>
                    </apex:outputPanel>

                    <apex:outputPanel rendered="{!upcomingFlights.size > 0}">
                        <div class="skp-table-wrap">
                            <table class="skp-table">
                                <thead>
                                    <tr>
                                        <th>Flight Name</th>
                                        <th>Airline</th>
                                        <th>Origin</th>
                                        <th>Destination</th>
                                        <th>Departure Date</th>
                                        <th>Departure Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <apex:repeat value="{!upcomingFlights}" var="fl">
                                        <tr>
                                            <td><strong><apex:outputText value="{!fl.Name}"/></strong></td>
                                            <td><apex:outputText value="{!fl.Airline_Name__c}"/></td>
                                            <td><apex:outputText value="{!fl.Origin_Airport__c}"/></td>
                                            <td><apex:outputText value="{!fl.Destination_Airport__c}"/></td>
                                            <td>
                                                <apex:outputText value="{0,date,dd/MM/yyyy}">
                                                    <apex:param value="{!fl.Departure_DateTime__c}"/>
                                                </apex:outputText>
                                            </td>
                                            <td>
                                                <apex:outputText value="{0,date,HH:mm}">
                                                    <apex:param value="{!fl.Departure_DateTime__c}"/>
                                                </apex:outputText>
                                            </td>
                                        </tr>
                                    </apex:repeat>
                                </tbody>
                            </table>
                        </div>
                    </apex:outputPanel>
                </div>

                <!-- ══════════════════════════════════════════════════
                     Section 5 · Quick Navigation Actions
                ═══════════════════════════════════════════════════ -->
                <div class="skp-card">
                    <div class="skp-card-title">🔗 Quick Navigation Links</div>
                    <div class="skp-actions-row">
                        <apex:commandButton value="Search Flights" action="{!goToFlightSearch}" styleClass="skp-btn skp-btn-primary"/>
                        <apex:commandButton value="Search Bookings" action="{!goToBookingSearch}" styleClass="skp-btn skp-btn-outline"/>
                        <apex:commandButton value="Create Booking" action="{!goToBookingCreate}" styleClass="skp-btn skp-btn-outline"/>
                    </div>
                </div>

            </apex:outputPanel>
        </div>
    </apex:form>
</apex:page>
